{
  "name": "open-eskd",
  "version": "3.0.0",
  "private": true,
  "description": "An offline, browser-only engineering configuration workspace.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check && npm run format:check && npm run schema:check && npm test && npm run build",
    "schema": "node scripts/schema.mjs",
    "schema:check": "node scripts/schema.mjs --check",
    "project:validate": "node scripts/project-cli.mjs validate",
    "project:tool": "node scripts/project-cli.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    "./core": "./src/domain/index.js",
    "./files": "./src/files/index.js",
    "./schema": "./src/domain/schema.js"
  }
}
